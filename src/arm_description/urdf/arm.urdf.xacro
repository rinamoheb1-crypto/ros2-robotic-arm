<?xml version="1.0"?>
<robot name="arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="base_h" value="0.08"/>
  <xacro:property name="l1" value="0.12"/>
  <xacro:property name="l2" value="0.15"/>
  <xacro:property name="l3" value="0.09"/>
  <xacro:property name="ee" value="0.06"/>
  <xacro:property name="r" value="0.015"/>

  <xacro:macro name="arm_link" params="name length mass color">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${r}" length="${length}"/></geometry>
        <material name="${name}_mat"><color rgba="${color}"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${r}" length="${length}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${mass*(3*r*r+length*length)/12}" ixy="0" ixz="0"
                 iyy="${mass*(3*r*r+length*length)/12}" iyz="0"
                 izz="${mass*r*r/2}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:arm_link name="base_link" length="${base_h}" mass="0.5" color="0.3 0.3 0.3 1"/>
  <xacro:arm_link name="l1" length="${l1}" mass="0.2" color="0.2 0.4 0.8 1"/>
  <xacro:arm_link name="l2" length="${l2}" mass="0.2" color="0.8 0.4 0.2 1"/>
  <xacro:arm_link name="l3" length="${l3}" mass="0.15" color="0.2 0.7 0.3 1"/>
  <xacro:arm_link name="end_effector" length="${ee}" mass="0.05" color="0.8 0.2 0.2 1"/>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/><child link="l1"/>
    <origin xyz="0 0 ${base_h}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="5" velocity="2"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="l1"/><child link="l2"/>
    <origin xyz="0 0 ${l1}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="2"/>
  </joint>

  <joint name="joint3" type="revolute">
    <parent link="l2"/><child link="l3"/>
    <origin xyz="0 0 ${l2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="2"/>
  </joint>

  <joint name="joint4" type="revolute">
    <parent link="l3"/><child link="end_effector"/>
    <origin xyz="0 0 ${l3}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="2"/>
  </joint>

</robot>

